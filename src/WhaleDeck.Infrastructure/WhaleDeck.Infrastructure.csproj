<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WhaleDeck.Application\WhaleDeck.Application.csproj" />
    <ProjectReference Include="..\WhaleDeck.Contracts\WhaleDeck.Contracts.csproj" />
    <ProjectReference Include="..\WhaleDeck.Domain\WhaleDeck.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Valkey.Glide" Version="1.1.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit's minimum is vulnerable; retain the explicit patched floor for all consumers. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence/Sql/MetricPartitions.*.sql" />
    <EmbeddedResource Include="Persistence/Sql/MetricAggregation.*.sql" />
  </ItemGroup>

</Project>
