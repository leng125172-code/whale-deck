#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || { echo 'This helper must run as root.' >&2; exit 1; }
action=${1:-}
approved_repository=/data/GitRepos/database-platform

validate_repository() {
  [[ $# -eq 1 && "$1" == "$approved_repository" && -d "$1/.git" ]] || exit 2
}

validate_commit_message() {
  [[ $# -eq 1 && ${#1} -ge 3 && ${#1} -le 120 ]] || exit 2
  if LC_ALL=C /usr/bin/printf '%s' "$1" | /usr/bin/grep -q '[[:cntrl:]]'; then
    exit 2
  fi
}

run_transient() {
  local unit=$1
  shift
  exec /usr/bin/systemd-run --quiet --wait --pipe --collect --service-type=exec \
    --unit="$unit" /usr/local/libexec/whaledeck-privileged "$@"
}

case "$action" in
  file-transport)
    [[ $# -eq 3 && "$2" =~ ^(roots|list|directories|search|content-search|stat|download|upload|stage|publish|discard|status|operation-plan|operation-apply|operation-status|operation-discard|archive-list|archive-plan|archive-apply|archive-status|archive-discard|tree-copy-plan|tree-copy-apply|tree-copy-status|tree-copy-discard|tree-move-plan|tree-move-apply|tree-move-status|tree-move-discard|tree-pack-plan|tree-pack-apply|tree-pack-status|tree-pack-discard|tree-pack-download|tree-unpack-plan|tree-unpack-apply|tree-unpack-status|tree-unpack-discard|tree-trash-plan|tree-trash-apply|tree-trash-status|tree-trash-discard|tree-restore-plan|tree-restore-apply|tree-restore-status|tree-restore-discard|tree-overwrite-restore-plan|tree-overwrite-restore-apply|tree-overwrite-restore-status|tree-overwrite-restore-discard|tree-purge-plan|tree-purge-apply|tree-purge-status|tree-purge-discard)$ && "$3" =~ ^[a-f0-9]{32}$ ]] || exit 2
    file_size_limit=1073741824
    file_memory_limit=128M
    file_cpu_quota=50%
    file_descriptor_limit=64
    file_runtime_limit=620
    if [[ "$2" == content-search ]]; then
      file_memory_limit=384M
      file_cpu_quota=100%
      file_runtime_limit=20
    fi
    if [[ "$2" == tree-copy-* || "$2" == tree-move-* || "$2" == tree-pack-* || "$2" == tree-unpack-* || "$2" == tree-trash-* || "$2" == tree-restore-* || "$2" == tree-overwrite-restore-* || "$2" == tree-purge-* ]]; then
      file_size_limit=17179869184
      file_memory_limit=384M
      file_cpu_quota=100%
      file_descriptor_limit=128
    fi
    if [[ "$2" == tree-pack-* || "$2" == tree-trash-* || "$2" == tree-overwrite-restore-* ]]; then file_size_limit=18253611008; fi
    # RestrictSUIDSGID seccomp blocks openat2 entirely, including read-only
    # resolution. Only this fixed, non-executing Python driver opts out: it
    # creates 0600 files and strips both special bits on every permission copy.
    # Other Agent/terminal/service sandboxes retain their original setting.
    exec /usr/bin/systemd-run --quiet --wait --pipe --collect --service-type=exec \
      --unit="whaledeck-files-$3" \
      --property=User=root --property=Group=root --property=UMask=0077 \
      --property=ProtectSystem=strict --property=ProtectHome=yes --property=PrivateTmp=yes \
      --property=PrivateDevices=yes --property=NoNewPrivileges=yes --property=RestrictSUIDSGID=no \
      --property=ProtectKernelTunables=yes --property=ProtectKernelModules=yes --property=ProtectControlGroups=yes \
      --property=RestrictNamespaces=yes --property=RestrictAddressFamilies=AF_UNIX \
      --property="RuntimeMaxSec=$file_runtime_limit" --property=TimeoutStopSec=5 --property=KillMode=control-group \
      --property=Restart=no --property=TasksMax=8 --property="MemoryMax=$file_memory_limit" --property="CPUQuota=$file_cpu_quota" \
      --property=LimitCORE=0 --property="LimitNOFILE=$file_descriptor_limit" --property="LimitFSIZE=$file_size_limit" \
      --property=BindsTo=whaledeck-agent.service --property=After=whaledeck-agent.service \
      --property="CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN" \
      --property="ReadWritePaths=/var/lib/whaledeck-files /data/WhaleDeck /data/DockerData/whaledeck/file-backups" \
      /usr/bin/python3 -I /usr/local/libexec/whaledeck-files.py "$2"
    ;;
  file-transport-stop)
    [[ $# -eq 3 && "$2" =~ ^[a-f0-9]{32}$ && "$3" =~ ^[a-f0-9]{32}$ ]] || exit 2
    files_instance=$(/usr/bin/systemctl show "whaledeck-files-$2.service" -p InvocationID --value 2>/dev/null || true)
    [[ -n "$files_instance" ]] || exit 0
    [[ "$files_instance" == "$3" ]] || exit 2
    exec /usr/bin/systemctl stop "whaledeck-files-$2.service"
    ;;
  container-terminal)
    [[ $# -eq 2 && "$2" =~ ^[a-f0-9]{32}$ ]] || exit 2
    exec /usr/bin/systemd-run --quiet --wait --pipe --collect --service-type=exec \
      --unit="whaledeck-terminal-$2" \
      --property=User=root --property=Group=root --property=UMask=0077 \
      --property=ProtectSystem=strict --property=ProtectHome=yes --property=PrivateTmp=yes \
      --property=PrivateDevices=yes --property=NoNewPrivileges=yes --property=RestrictSUIDSGID=yes \
      --property=ProtectKernelTunables=yes --property=ProtectKernelModules=yes --property=ProtectControlGroups=yes \
      --property=RuntimeMaxSec=660 --property=TimeoutStopSec=8 --property=KillMode=control-group \
      --property=Restart=no --property=TasksMax=16 --property=MemoryMax=64M --property=CPUQuota=25% --property=LimitCORE=0 \
      --property=BindsTo=whaledeck-agent.service --property=After=whaledeck-agent.service \
      --property=RestrictAddressFamilies=AF_UNIX \
      --property="CapabilityBoundingSet=CAP_KILL CAP_DAC_READ_SEARCH CAP_SYS_PTRACE" \
      --property="ExecStartPre=/usr/bin/python3 -I /usr/local/libexec/whaledeck-container-terminal.py reserve $2" \
      --property="ExecStopPost=/usr/bin/python3 -I /usr/local/libexec/whaledeck-container-terminal.py finish $2" \
      --property=ReadWritePaths=/var/lib/whaledeck-terminal \
      /usr/bin/python3 -I /usr/local/libexec/whaledeck-container-terminal.py run "$2"
    ;;
  host-terminal)
    [[ $# -eq 2 && "$2" =~ ^[a-f0-9]{32}$ ]] || exit 2
    exec /usr/bin/systemd-run --quiet --wait --pipe --collect --service-type=exec \
      --unit="whaledeck-terminal-$2" \
      --property=User=whaledeck-shell --property=Group=whaledeck-shell --property=UMask=0077 \
      --property=ProtectSystem=strict --property=ProtectHome=yes --property=PrivateTmp=yes \
      --property=PrivateDevices=yes --property=NoNewPrivileges=yes --property=RestrictSUIDSGID=yes \
      --property=ProtectKernelTunables=yes --property=ProtectKernelModules=yes --property=ProtectControlGroups=yes \
      --property=RuntimeMaxSec=660 --property=TimeoutStopSec=5 --property=KillMode=control-group \
      --property=Restart=no --property=TasksMax=64 --property=MemoryMax=256M --property=CPUQuota=50% --property=LimitCORE=0 \
      --property=BindsTo=whaledeck-agent.service --property=After=whaledeck-agent.service \
      --property=CapabilityBoundingSet= \
      --property="ExecStartPre=!/usr/bin/python3 -I /usr/local/libexec/whaledeck-host-terminal.py reserve $2" \
      --property="ExecStopPost=!/usr/bin/python3 -I /usr/local/libexec/whaledeck-host-terminal.py finish $2" \
      --property="ReadWritePaths=/var/lib/whaledeck-terminal /var/lib/whaledeck-shell" \
      /usr/bin/python3 -I /usr/local/libexec/whaledeck-host-terminal.py run "$2"
    ;;
  host-terminal-stop)
    [[ $# -eq 3 && "$2" =~ ^[a-f0-9]{32}$ && "$3" =~ ^[a-f0-9]{32}$ ]] || exit 2
    terminal_instance=$(/usr/bin/systemctl show "whaledeck-terminal-$2.service" -p InvocationID --value 2>/dev/null || true)
    [[ -n "$terminal_instance" ]] || exit 0
    [[ "$terminal_instance" == "$3" ]] || exit 2
    exec /usr/bin/systemctl stop "whaledeck-terminal-$2.service"
    ;;
  notification-config)
    [[ $# -eq 2 && ( "$2" == inspect || "$2" == apply || "$2" == remove ) ]] || exit 2
    # Escape only the caller's read-only mount namespace through PID 1; the
    # trusted transient writer itself remains strict with one writable directory.
    # --pipe carries private stdin without argv, environment or staging files.
    exec /usr/bin/systemd-run --quiet --wait --pipe --collect --service-type=exec \
      --unit="whaledeck-notification-config-$$-$RANDOM" \
      --property=User=root --property=Group=whaledeck \
      --property=ProtectSystem=strict --property=ReadWritePaths=/etc/whaledeck/notifications \
      --property=ProtectHome=yes --property=PrivateTmp=yes --property=NoNewPrivileges=yes \
      --property=RuntimeMaxSec=15 --property=TimeoutStopSec=5 --property=KillMode=control-group \
      --property=RestrictAddressFamilies=AF_UNIX \
      /usr/bin/python3 -I /usr/local/libexec/whaledeck-notification-config.py "$2"
    ;;
  self-check)
    [[ $# -eq 1 ]] || exit 2
    printf 'ok\n'
    ;;
  docker-validate)
    [[ $# -eq 2 && "$2" == /etc/docker/daemon.json.whaledeck-candidate ]] || exit 2
    exec /usr/bin/dockerd --validate --config-file "$2"
    ;;
  docker-stage)
    [[ $# -eq 1 ]] || exit 2
    temporary=$(/usr/bin/mktemp /etc/docker/daemon.json.whaledeck-candidate.XXXXXX)
    trap '/usr/bin/rm -f -- "$temporary"' EXIT
    /usr/bin/timeout 5 /usr/bin/head -c 65537 > "$temporary"
    [[ $(/usr/bin/stat -c %s "$temporary") -le 65536 ]] || exit 2
    /usr/bin/jq -e 'type == "object"' "$temporary" >/dev/null
    /usr/bin/install -o root -g root -m 0644 "$temporary" /etc/docker/daemon.json.whaledeck-candidate
    ;;
  docker-apply)
    [[ $# -eq 2 && "$2" == /etc/docker/daemon.json.whaledeck-candidate ]] || exit 2
    /usr/bin/install -o root -g root -m 0644 /etc/docker/daemon.json /etc/docker/daemon.json.whaledeck-backup
    /usr/bin/install -o root -g root -m 0644 "$2" /etc/docker/daemon.json
    if ! /usr/bin/systemctl restart docker.service; then
      /usr/bin/install -o root -g root -m 0644 /etc/docker/daemon.json.whaledeck-backup /etc/docker/daemon.json
      /usr/bin/systemctl restart docker.service
      exit 1
    fi
    ;;
  docker-rollback)
    [[ $# -eq 1 && -f /etc/docker/daemon.json.whaledeck-backup ]] || exit 2
    /usr/bin/install -o root -g root -m 0644 /etc/docker/daemon.json.whaledeck-backup /etc/docker/daemon.json
    exec /usr/bin/systemctl restart docker.service
    ;;
  system-update-check)
    [[ $# -eq 1 ]] || exit 2
    run_transient whaledeck-system-update-check system-update-check-host
    ;;
  system-update-install)
    [[ $# -eq 1 ]] || exit 2
    run_transient whaledeck-system-update-install system-update-install-host
    ;;
  system-update-check-host)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/apt-get --simulate upgrade
    ;;
  system-update-install-host)
    [[ $# -eq 1 ]] || exit 2
    /usr/bin/apt-get update
    exec /usr/bin/apt-get --yes upgrade
    ;;
  storage-smart)
    [[ $# -eq 2 ]] || exit 2
    device=$2
    [[ "$device" =~ ^/dev/(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+)$ ]] || exit 2
    [[ -b "$device" ]] || exit 2
    if ! command -v smartctl >/dev/null 2>&1; then
      exec /usr/bin/jq -cn '{passed:null,temperature:null,available:false}'
    fi
    smart_json=$(/usr/sbin/smartctl --json=c --health --attributes "$device" 2>/dev/null || true)
    /usr/bin/printf '%s' "$smart_json" |
      /usr/bin/jq -c '{passed:(.smart_status.passed // null),temperature:(.temperature.current // .nvme_smart_health_information_log.temperature // null),available:true}'
    ;;
  config-repository-stage)
    [[ $# -eq 2 ]] || exit 2
    validate_repository "$2"
    run_transient whaledeck-config-repository-stage config-repository-stage-host "$2"
    ;;
  config-repository-stage-host)
    [[ $# -eq 2 ]] || exit 2
    validate_repository "$2"
    exec /usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
      /usr/bin/git -C "$2" add --all
    ;;
  config-repository-status)
    [[ $# -eq 2 ]] || exit 2
    validate_repository "$2"
    run_transient whaledeck-config-repository-status config-repository-status-host "$2"
    ;;
  config-repository-status-host)
    [[ $# -eq 2 ]] || exit 2
    validate_repository "$2"
    branch=$(/usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
      /usr/bin/git -C "$2" branch --show-current)
    commit=$(/usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
      /usr/bin/git -C "$2" rev-parse HEAD)
    status=$(/usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
      /usr/bin/git -C "$2" status --porcelain)
    [[ -n "$status" ]] && dirty=true || dirty=false
    exec /usr/bin/jq -cn --arg branch "$branch" --arg commit "$commit" --argjson dirty "$dirty" \
      '{branch:$branch,commit:$commit,dirty:$dirty}'
    ;;
  config-repository-list-files)
    [[ $# -eq 3 ]] || exit 2
    validate_repository "$2"
    [[ "$3" == working || "$3" == staged ]] || exit 2
    run_transient "whaledeck-config-repository-list-$3" config-repository-list-files-host "$2" "$3"
    ;;
  config-repository-list-files-host)
    [[ $# -eq 3 ]] || exit 2
    validate_repository "$2"
    if [[ "$3" == working ]]; then
      exec /usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
        /usr/bin/git -C "$2" ls-files -co --exclude-standard -z
    fi
    [[ "$3" == staged ]] || exit 2
    exec /usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
      /usr/bin/git -C "$2" diff --cached --name-only -z
    ;;
  config-repository-reset-stage)
    [[ $# -eq 2 ]] || exit 2
    validate_repository "$2"
    run_transient whaledeck-config-repository-reset-stage config-repository-reset-stage-host "$2"
    ;;
  config-repository-reset-stage-host)
    [[ $# -eq 2 ]] || exit 2
    validate_repository "$2"
    exec /usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
      /usr/bin/git -C "$2" reset --quiet
    ;;
  config-repository-commit-push)
    [[ $# -eq 3 ]] || exit 2
    validate_repository "$2"
    validate_commit_message "$3"
    run_transient whaledeck-config-repository-commit-push config-repository-commit-push-host "$2" "$3"
    ;;
  config-repository-commit-push-host)
    [[ $# -eq 3 ]] || exit 2
    validate_repository "$2"
    validate_commit_message "$3"
    if ! /usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
      /usr/bin/git -C "$2" diff --cached --quiet; then
      /usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
        /usr/bin/git -C "$2" -c user.name='Whale Deck' -c user.email=whaledeck@localhost commit -m "$3"
    fi
    exec /usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
      /usr/bin/git -C "$2" push origin HEAD
    ;;
  platform-plan-update)
    [[ $# -eq 1 ]] || exit 2
    run_transient whaledeck-platform-plan-update platform-plan-update-host
    ;;
  platform-plan-update-host)
    [[ $# -eq 1 ]] || exit 2
    for repository in /data/GitRepos/whale-deck /data/GitRepos/database-platform; do
      [[ -d "$repository/.git" ]] || exit 2
      /usr/sbin/runuser -u user -- /usr/bin/env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
        /usr/bin/git -C "$repository" status --short
    done
    ;;
  platform-diagnose)
    [[ $# -eq 1 ]] || exit 2
    run_transient whaledeck-platform-diagnose platform-diagnose-host
    ;;
  platform-diagnose-host)
    [[ $# -eq 1 ]] || exit 2
    exec /data/GitRepos/database-platform/scripts/check-all.sh
    ;;
  platform-diagnostic-bundle)
    [[ $# -eq 1 ]] || exit 2
    run_transient whaledeck-platform-diagnostic-bundle platform-diagnostic-bundle-host
    ;;
  platform-diagnostic-bundle-host)
    [[ $# -eq 1 ]] || exit 2
    diagnostics_root=/var/lib/whaledeck-agent/diagnostics
    /usr/bin/install -d -o root -g whaledeck -m 0750 "$diagnostics_root"
    /usr/bin/find "$diagnostics_root" -maxdepth 1 -type f -name '*.tar.gz' -mmin +1440 -delete
    bundle_id=$(/usr/bin/od -An -N16 -tx1 /dev/urandom | /usr/bin/tr -d ' \n')
    [[ "$bundle_id" =~ ^[a-f0-9]{32}$ ]] || exit 1
    temporary=$(/usr/bin/mktemp -d "$diagnostics_root/.bundle.XXXXXX")
    trap '/usr/bin/rm -rf -- "$temporary"' EXIT

    /usr/bin/jq -cn \
      --arg generatedAtUtc "$(/usr/bin/date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg hostName "$(/usr/bin/hostname)" \
      --arg whaleDeckRevision "$(/usr/bin/git -C /data/GitRepos/whale-deck rev-parse HEAD 2>/dev/null || true)" \
      --arg databasePlatformRevision "$(/usr/bin/git -C /data/GitRepos/database-platform rev-parse HEAD 2>/dev/null || true)" \
      '{generatedAtUtc:$generatedAtUtc,hostName:$hostName,whaleDeckRevision:$whaleDeckRevision,databasePlatformRevision:$databasePlatformRevision}' \
      > "$temporary/metadata.json"
    /usr/bin/uname -a > "$temporary/kernel.txt"
    /usr/bin/df -hT / /data /data/DockerData > "$temporary/storage.txt" 2>&1 || true
    /usr/bin/systemctl --no-pager --plain --full is-active docker.service whaledeck-agent.service whaledeck-maintenance.service database-platform-workstation-update.timer \
      > "$temporary/services.txt" 2>&1 || true
    /usr/bin/docker ps --all --format '{"name":{{json .Names}},"image":{{json .Image}},"state":{{json .State}},"status":{{json .Status}}}' \
      > "$temporary/containers.jsonl" 2>&1 || true
    /usr/bin/docker version --format '{{json .}}' > "$temporary/docker-version.json" 2>&1 || true
    {
      /usr/bin/journalctl --no-pager --output=short-iso --since '-2 hours' --priority=err \
        --unit=docker.service --unit=whaledeck-agent.service --unit=whaledeck-maintenance.service \
        --unit=database-platform-workstation-update.service --lines=200 2>&1 || true
    } | /usr/bin/sed -E '/(password|secret|token|authorization|cookie|api[_-]?key|credential)/Id' \
      > "$temporary/recent-errors.txt"

    archive="$diagnostics_root/$bundle_id.tar.gz"
    /usr/bin/tar -C "$temporary" -czf "$archive" .
    size=$(/usr/bin/stat -c %s "$archive")
    [[ "$size" -le 10485760 ]] || { /usr/bin/rm -f -- "$archive"; exit 1; }
    /usr/bin/chown root:whaledeck "$archive"
    /usr/bin/chmod 0640 "$archive"
    expires_at=$(/usr/bin/date -u -d '+24 hours' +%Y-%m-%dT%H:%M:%SZ)
    /usr/bin/jq -cn --arg bundleId "$bundle_id" --arg fileName "whaledeck-diagnostics-$bundle_id.tar.gz" \
      --argjson sizeBytes "$size" --arg expiresAtUtc "$expires_at" \
      '{bundleId:$bundleId,fileName:$fileName,sizeBytes:$sizeBytes,expiresAtUtc:$expiresAtUtc}'
    ;;
  systemd)
    [[ $# -eq 3 ]] || exit 2
    unit=$2
    verb=$3
    [[ "$unit" =~ ^(docker|database-platform-workstation-update|whaledeck-agent|whaledeck-maintenance)\.(service|timer)$ ]] || exit 2
    [[ "$verb" =~ ^(start|stop|restart)$ ]] || exit 2
    exec /usr/bin/systemctl "$verb" "$unit"
    ;;
  systemd-schedule)
    [[ $# -eq 3 ]] || exit 2
    unit=$2
    verb=$3
    [[ "$unit" == whaledeck-agent.service && "$verb" == restart ]] || exit 2
    exec /usr/bin/systemd-run --unit=whaledeck-agent-restart --collect --on-active=3s /usr/bin/systemctl restart "$unit"
    ;;
  backup-target-capacity)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/python3 /usr/local/libexec/whaledeck-application-backup.py capacity
    ;;
  application-backup-plan|application-backup-verify-plan)
    [[ $# -ge 3 && "$2" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || exit 2
    if [[ "$action" == application-backup-plan ]]; then
      [[ $# -eq 4 && "$4" =~ ^[0-9]+$ && "$4" -ge 51 && "$4" -le 99 ]] || exit 2
      [[ "$3" == live || "$3" == quiesced ]] || exit 2
      exec /usr/bin/python3 /usr/local/libexec/whaledeck-application-backup.py plan "$2" "$3" "$4"
    fi
    [[ $# -eq 3 && "$3" =~ ^[a-f0-9]{32}$ ]] || exit 2
    exec /usr/bin/python3 /usr/local/libexec/whaledeck-application-backup.py verify-plan "$2" "$3"
    ;;
  application-backup-cleanup-plan)
    [[ $# -eq 4 && "$2" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || exit 2
    [[ "$3" =~ ^[0-9]+$ && "$3" -ge 1 && "$3" -le 3650 && "$4" =~ ^[0-9]+$ && "$4" -ge 1 && "$4" -le 365 ]] || exit 2
    exec /usr/bin/python3 /usr/local/libexec/whaledeck-application-backup.py cleanup-plan "$2" "$3" "$4"
    ;;
  application-backup-run|application-backup-cleanup-run)
    [[ $# -eq 6 && "$2" =~ ^[a-z0-9][a-z0-9-]{0,62}$ && "$3" =~ ^[a-f0-9]{32}$ ]] || exit 2
    backup_verb=run
    if [[ "$action" == application-backup-run ]]; then
      [[ "$4" == live || "$4" == quiesced ]] || exit 2
      [[ "$5" =~ ^[a-f0-9]{64}$ && "$6" =~ ^[0-9]+$ && "$6" -ge 51 && "$6" -le 99 ]] || exit 2
    else
      backup_verb=cleanup-run
      [[ "$4" =~ ^[0-9]+$ && "$4" -ge 1 && "$4" -le 3650 && "$5" =~ ^[0-9]+$ && "$5" -ge 1 && "$5" -le 365 ]] || exit 2
      [[ "$6" =~ ^[a-f0-9]{64}$ ]] || exit 2
    fi
    exec /usr/bin/systemd-run --quiet --no-block --collect --service-type=exec \
      --unit="whaledeck-application-backup-$3" \
      --property=RuntimeMaxSec=7200 --property=TimeoutStopSec=120 --property=UMask=0077 \
      --property=KillMode=control-group --property=Restart=no \
      --property=NoNewPrivileges=yes --property=ProtectSystem=strict --property=ProtectHome=yes \
      --property=PrivateTmp=yes --property=PrivateDevices=yes --property=RestrictAddressFamilies=AF_UNIX \
      --property="ReadWritePaths=/data/DockerData/whaledeck/application-backups /var/lib/whaledeck-application-backup" \
      --property="CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE" \
      --property=CPUQuota=50% --property=MemoryMax=256M --property=IOWeight=50 \
      --property="ExecStopPost=/usr/bin/python3 /usr/local/libexec/whaledeck-application-backup.py recover-job $3" \
      /usr/bin/python3 /usr/local/libexec/whaledeck-application-backup.py "$backup_verb" "$2" "$3" "$4" "$5" "$6"
    ;;
  application-backup-status)
    [[ $# -eq 3 && "$2" =~ ^[a-z0-9][a-z0-9-]{0,62}$ && "$3" =~ ^[a-f0-9]{32}$ ]] || exit 2
    exec /usr/bin/python3 /usr/local/libexec/whaledeck-application-backup.py status "$2" "$3"
    ;;
  application-backup-cancel)
    [[ $# -eq 2 && "$2" =~ ^[a-f0-9]{32}$ ]] || exit 2
    exec /usr/bin/systemctl stop "whaledeck-application-backup-$2.service"
    ;;
  application-backup-verify)
    [[ $# -eq 4 && "$2" =~ ^[a-z0-9][a-z0-9-]{0,62}$ && "$3" =~ ^[a-f0-9]{32}$ && "$4" =~ ^[a-f0-9]{64}$ ]] || exit 2
    exec /usr/bin/python3 /usr/local/libexec/whaledeck-application-backup.py verify "$2" "$3" "$4"
    ;;
  database-backup)
    [[ $# -eq 7 ]] || exit 2
    engine=$2
    verb=$3
    critical_percent=$4
    retention_days=$5
    retention_count=$6
    verify_after_backup=$7
    [[ "$engine" =~ ^(postgres|mariaDb|mongoDb|sqlServer|valkey|valkey72)$ ]] || exit 2
    [[ "$verb" =~ ^(run|verify)$ ]] || exit 2
    [[ "$critical_percent" =~ ^[0-9]+$ && "$critical_percent" -ge 51 && "$critical_percent" -le 99 ]] || exit 2
    [[ "$retention_days" =~ ^[0-9]+$ && "$retention_days" -ge 1 && "$retention_days" -le 3650 ]] || exit 2
    [[ "$retention_count" =~ ^[0-9]+$ && "$retention_count" -ge 1 && "$retention_count" -le 365 ]] || exit 2
    [[ "$verify_after_backup" == true || "$verify_after_backup" == false ]] || exit 2
    if [[ "$verb" == run ]]; then
      used_percent=$(/usr/bin/df --output=pcent /data/DockerData | /usr/bin/tail -n 1 | /usr/bin/tr -dc '0-9')
      [[ -n "$used_percent" && "$used_percent" -lt "$critical_percent" ]] || {
        echo 'Backup target has reached the configured critical capacity threshold.' >&2
        exit 75
      }
      export BACKUP_RETENTION_DAYS="$retention_days" BACKUP_RETENTION_COUNT="$retention_count"
      "/data/GitRepos/database-platform/$engine/scripts/backup.sh" >&2
      if [[ "$verify_after_backup" == true ]]; then
        "/data/GitRepos/database-platform/$engine/scripts/verify-backup.sh" >&2
      fi
    else
      verify_after_backup=true
      "/data/GitRepos/database-platform/$engine/scripts/verify-backup.sh" >&2
    fi
    export BACKUP_VERIFIED="$verify_after_backup"
    exec /data/GitRepos/database-platform/scripts/backup-metadata.sh "$engine"
    ;;
  platform-update-schedule)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/systemd-run --unit=whaledeck-platform-update --collect --on-active=3s /usr/local/libexec/whaledeck-platform-maintenance update
    ;;
  platform-rollback-schedule)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/systemd-run --unit=whaledeck-platform-rollback --collect --on-active=3s /usr/local/libexec/whaledeck-platform-maintenance rollback
    ;;
  reboot)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/systemctl reboot
    ;;
  reboot-schedule)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/systemd-run --unit=whaledeck-reboot --collect --on-active=5s /usr/bin/systemctl reboot
    ;;
  *)
    echo 'Unsupported privileged action.' >&2
    exit 2
    ;;
esac
