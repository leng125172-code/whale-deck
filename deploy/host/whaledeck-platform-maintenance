#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
# Read-only Git commands can refresh the index as an optional optimization.
# Root must not replace the development user's index with a root-owned 0600 file.
export GIT_OPTIONAL_LOCKS=0

[[ $EUID -eq 0 ]] || { echo 'Platform maintenance must run as root.' >&2; exit 1; }
action=${1:-}
source_root=/data/GitRepos/whale-deck
state_root=/var/lib/whaledeck-agent/platform-maintenance
revision_helper=/usr/local/libexec/whaledeck-platform-revisions.py
recovery_helper=/usr/local/libexec/whaledeck-platform-control-recovery.py
rollback_root=
status_file=/run/whaledeck/maintenance/status.json
lock_file=/run/lock/whaledeck-platform-maintenance.lock
maintenance_started=false

[[ -d $source_root/.git && -r $source_root/.env && -r $source_root/.images.env ]] || {
  echo 'Whale Deck source or private runtime configuration is unavailable.' >&2
  exit 1
}
[[ ! -L $state_root ]] || exit 1
install -d -o root -g root -m 0700 "$state_root"
# Agent publishes operation progress with atomic rename, while this root helper
# publishes the longer deployment state. Both writers need directory access;
# the shared service group remains the only non-root principal with access.
install -d -o whaledeck-agent -g whaledeck -m 0770 "$(dirname "$status_file")"
/usr/bin/python3 -I "$recovery_helper" init-lock
exec 9<>"$lock_file"
flock -n 9 || { echo 'Another platform maintenance operation is active.' >&2; exit 1; }

# The checkout intentionally remains owned by the non-root development user.
# Maintenance runs as root, so trust only this exact checkout for each Git
# invocation instead of weakening the machine-wide safe.directory policy.
git_source() {
  /usr/bin/git -c "safe.directory=$source_root" -C "$source_root" "$@"
}

write_status() {
  /usr/bin/python3 -I "$recovery_helper" status-held "$1"
}

report_failure() {
  local exit_code=$?
  trap - ERR
  if [[ $maintenance_started == true ]]; then
    write_status failed 'Whale Deck 发布失败；请修复问题后重新发布。' || true
  fi
  exit "$exit_code"
}

trap report_failure ERR

compose_for() {
  local project_root=$1
  shift
  # compose.yml owns the stable project name (`whaledeck`). Do not override it
  # here or Compose will treat the running control plane as an unrelated stack.
  docker compose --project-directory "$project_root" \
    --env-file "$source_root/.env" --env-file "$source_root/.images.env" \
    -f "$project_root/compose.yml" "$@"
}

deploy_revision() {
  local project_root=$1 migrate=$2 expected_revision=$3
  export WHALEDECK_BUILD_REVISION
  WHALEDECK_BUILD_REVISION=$(/usr/bin/git -c "safe.directory=$project_root" -C "$project_root" rev-parse HEAD)
  [[ $WHALEDECK_BUILD_REVISION =~ ^[a-f0-9]{40}$ ]] || return 2
  [[ $WHALEDECK_BUILD_REVISION == "$expected_revision" ]] || return 2
  "$project_root/deploy/host/publish-and-install.sh"
  compose_for "$project_root" --profile tools config --quiet
  if [[ -f $project_root/deploy/build-images.sh ]]; then
    bash "$project_root/deploy/build-images.sh"
  elif [[ $migrate == false ]]; then
    # Explicit manual rollback may target a pre-provenance commit. Its legacy
    # binaries are not claimed to pass the new provenance verifier.
    compose_for "$project_root" --profile tools build --pull
  else
    echo 'The update revision has no frozen image builder.' >&2
    return 2
  fi
  [[ $(/usr/bin/git -c "safe.directory=$project_root" -C "$project_root" rev-parse HEAD) == "$expected_revision" ]] || return 2
  [[ -z $(/usr/bin/git -c "safe.directory=$project_root" -C "$project_root" status --porcelain) ]] || return 2
  if [[ $migrate == true ]]; then
    compose_for "$project_root" --profile tools run --rm --no-deps migrator
  fi
  # Development publishes must replace every runtime container even when the
  # Compose configuration hash is unchanged; otherwise a newly built frontend
  # image can remain hidden behind the previous Gateway container.
  compose_for "$project_root" up -d --force-recreate --wait --wait-timeout 180
}

cleanup_exit() {
  local result=$?
  trap - EXIT ERR
  # Normal failure can discard its exact private worktree. SIGKILL/boot recovery
  # deliberately performs no Git or application operation and preserves it.
  if [[ -n $rollback_root && -e $rollback_root ]]; then
    git_source worktree remove --force "$rollback_root" >/dev/null 2>&1 || result=1
  fi
  /usr/bin/python3 -I "$recovery_helper" recover-held || result=1
  exit "$result"
}
trap cleanup_exit EXIT
# Resolve an older interrupted controller transaction before preparing a new
# ledger operation. The inherited root-owned fd9 proves the global lock.
/usr/bin/python3 -I "$recovery_helper" recover-held

case "$action" in
  update)
    [[ -z $(git_source status --porcelain) ]] || { echo 'Whale Deck checkout has local changes.' >&2; exit 1; }
    branch=$(git_source branch --show-current)
    [[ $branch =~ ^[A-Za-z0-9._/-]{1,120}$ ]] || exit 2
    target=$(git_source rev-parse HEAD)
    prepared=$(/usr/bin/python3 -I "$revision_helper" prepare update "$target")
    read -r revision attempt extra <<< "$prepared"
    [[ $revision == "$target" && $attempt =~ ^[a-f0-9]{32}$ && -z $extra ]] || exit 2
    capture=$(/usr/bin/python3 -I "$recovery_helper" checkpoint-held update "$revision" "$attempt")
    [[ $capture =~ ^[a-f0-9]{32}$ ]] || exit 2
    revision_helper="$state_root/control-$capture/whaledeck-platform-revisions.py"
    maintenance_started=true
    write_status updating
    deploy_revision "$source_root" true "$revision"
    /usr/bin/python3 -I "$revision_helper" finish update "$revision" "$attempt"
    /usr/bin/python3 -I "$recovery_helper" complete-held "$capture" update "$revision" "$attempt"
    ;;
  rollback)
    prepared=$(/usr/bin/python3 -I "$revision_helper" prepare rollback)
    read -r revision attempt extra <<< "$prepared"
    [[ $revision =~ ^[a-f0-9]{40}$ && $attempt =~ ^[a-f0-9]{32}$ && -z $extra ]] || exit 2
    git_source cat-file -e "$revision^{commit}"
    capture=$(/usr/bin/python3 -I "$recovery_helper" checkpoint-held rollback "$revision" "$attempt")
    [[ $capture =~ ^[a-f0-9]{32}$ ]] || exit 2
    revision_helper="$state_root/control-$capture/whaledeck-platform-revisions.py"
    rollback_root="$state_root/rollback-src"
    [[ ! -e $rollback_root ]] || git_source worktree remove --force "$rollback_root"
    maintenance_started=true
    write_status rollingBack
    git_source worktree add --detach "$rollback_root" "$revision"
    install -o root -g root -m 0600 "$source_root/.images.env" "$rollback_root/.images.env"
    deploy_revision "$rollback_root" false "$revision"
    /usr/bin/python3 -I "$revision_helper" finish rollback "$revision" "$attempt"
    git_source worktree remove --force "$rollback_root"
    rollback_root=
    /usr/bin/python3 -I "$recovery_helper" complete-held "$capture" rollback "$revision" "$attempt"
    ;;
  *)
    echo 'Usage: whaledeck-platform-maintenance update|rollback' >&2
    exit 2
    ;;
esac
