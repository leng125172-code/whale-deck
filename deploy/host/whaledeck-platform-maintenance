#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
# Read-only Git commands can refresh the index as an optional optimization.
# Root must not replace the development user's index with a root-owned 0600 file.
export GIT_OPTIONAL_LOCKS=0

[[ $EUID -eq 0 ]] || { echo 'Platform maintenance must run as root.' >&2; exit 1; }
action=${1:-}
source_root=/data/GitRepos/whale-deck
state_root=/var/lib/whaledeck-agent/platform-maintenance
previous_file="$state_root/previous-revision"
status_file=/run/whaledeck/maintenance/status.json
lock_file=/run/lock/whaledeck-platform-maintenance.lock

[[ -d $source_root/.git && -r $source_root/.env && -r $source_root/.images.env ]] || {
  echo 'Whale Deck source or private runtime configuration is unavailable.' >&2
  exit 1
}
install -d -o root -g root -m 0700 "$state_root"
# Agent publishes operation progress with atomic rename, while this root helper
# publishes the longer deployment state. Both writers need directory access;
# the shared service group remains the only non-root principal with access.
install -d -o whaledeck-agent -g whaledeck -m 0770 "$(dirname "$status_file")"
exec 9>"$lock_file"
flock -n 9 || { echo 'Another platform maintenance operation is active.' >&2; exit 1; }

# The checkout intentionally remains owned by the non-root development user.
# Maintenance runs as root, so trust only this exact checkout for each Git
# invocation instead of weakening the machine-wide safe.directory policy.
git_source() {
  /usr/bin/git -c "safe.directory=$source_root" -C "$source_root" "$@"
}

write_status() {
  local state=$1 message=$2
  printf '{"state":"%s","message":"%s","updatedAtUtc":"%s"}\n' \
    "$state" "$message" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$status_file"
  chown root:whaledeck "$status_file"
  chmod 0640 "$status_file"
}

report_failure() {
  local exit_code=$?
  trap - ERR
  write_status failed 'Whale Deck 发布失败；请修复问题后重新发布。' || true
  exit "$exit_code"
}

trap report_failure ERR

compose_for() {
  local project_root=$1
  shift
  # compose.yml owns the stable project name (`whaledeck`). Do not override it
  # here or Compose will treat the running control plane as an unrelated stack.
  docker compose --project-directory "$project_root" \
    --env-file "$source_root/.env" --env-file "$source_root/.images.env" \
    -f "$project_root/compose.yml" "$@"
}

deploy_revision() {
  local project_root=$1 migrate=$2
  "$project_root/deploy/host/publish-and-install.sh"
  compose_for "$project_root" --profile tools config --quiet
  compose_for "$project_root" --profile tools build --pull
  if [[ $migrate == true ]]; then
    compose_for "$project_root" --profile tools run --rm --no-deps migrator
  fi
  # Development publishes must replace every runtime container even when the
  # Compose configuration hash is unchanged; otherwise a newly built frontend
  # image can remain hidden behind the previous Gateway container.
  compose_for "$project_root" up -d --force-recreate --wait --wait-timeout 180
}

case "$action" in
  update)
    [[ -z $(git_source status --porcelain) ]] || { echo 'Whale Deck checkout has local changes.' >&2; exit 1; }
    branch=$(git_source branch --show-current)
    [[ $branch =~ ^[A-Za-z0-9._/-]{1,120}$ ]] || { echo 'The current update branch is invalid.' >&2; exit 1; }
    before=$(git_source rev-parse HEAD)
    # The repository owner fast-forwards the checkout before scheduling this
    # privileged phase. Root deploys that exact tested revision and therefore
    # does not depend on a desktop proxy or hold GitHub credentials.
    write_status updating '正在部署当前 Whale Deck 开发版本。'
    printf '%s\n' "$before" > "$previous_file"
    deploy_revision "$source_root" true
    write_status healthy 'Whale Deck 更新完成。'
    ;;
  rollback)
    [[ -r $previous_file ]] || { echo 'No previous Whale Deck revision is recorded.' >&2; exit 1; }
    revision=$(<"$previous_file")
    [[ $revision =~ ^[a-f0-9]{40}$ ]] || { echo 'The recorded rollback revision is invalid.' >&2; exit 1; }
    git_source cat-file -e "$revision^{commit}"
    rollback_root="$state_root/rollback-src"
    [[ ! -e $rollback_root ]] || git_source worktree remove --force "$rollback_root"
    write_status rollingBack '正在回退 Whale Deck；数据库迁移不会降级。'
    git_source worktree add --detach "$rollback_root" "$revision"
    trap 'git_source worktree remove --force "$rollback_root" >/dev/null 2>&1 || true' EXIT
    install -o root -g root -m 0600 "$source_root/.images.env" "$rollback_root/.images.env"
    deploy_revision "$rollback_root" false
    git_source worktree remove --force "$rollback_root"
    trap - EXIT
    write_status healthy 'Whale Deck 已回退到上一版本。'
    ;;
  *)
    echo 'Usage: whaledeck-platform-maintenance update|rollback' >&2
    exit 2
    ;;
esac
