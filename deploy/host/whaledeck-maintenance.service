[Unit]
Description=Whale Deck stable maintenance and reverse proxy endpoint
Requires=whaledeck-maintenance.socket
After=network-online.target whaledeck-maintenance.socket whaledeck-platform-control-recovery.service
Wants=network-online.target

[Service]
Type=simple
User=whaledeck-maintenance
Group=whaledeck
WorkingDirectory=/opt/whaledeck-maintenance
ExecStart=/opt/whaledeck-maintenance/WhaleDeck.MaintenanceHost
Restart=always
RestartSec=3s
Sockets=whaledeck-maintenance.socket
Environment=Maintenance__SocketActivation=required
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_NETLINK is read-only here and is required to resolve which local
# interface owns the request destination address. Container bridge interfaces
# are then rejected by the application before proxying.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadOnlyPaths=-/run/whaledeck/maintenance

[Install]
WantedBy=multi-user.target
